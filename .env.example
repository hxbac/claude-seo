# Copy this file to ~/.config/ai-content/credentials.env (recommended) or to
# ~/.claude/.env (still supported) and fill in the values you have.
#
#     mkdir -p ~/.config/ai-content
#     cp .env.example ~/.config/ai-content/credentials.env
#     chmod 700 ~/.config/ai-content
#     chmod 600 ~/.config/ai-content/credentials.env
#
# Every script in claude-blog, claude-seo and codex-seo reads one such file on
# startup, so credentials never have to be typed on a command line or exported
# by hand. Search order, first file that exists wins, never merged:
#
#     1. $AI_CONTENT_ENV_FILE                  agent neutral; empty disables loading
#     2. $CLAUDE_ENV_FILE                      legacy; empty disables loading
#     3. ~/.config/ai-content/credentials.env  recommended location
#     4. ~/.claude/.env                        still read, nothing breaks
#     5. <repo>/.env                           development checkout only
#
# Check what the toolchain can see with:
#
#     python3 scripts/env_file.py --check
#
# Parsing rules: one KEY=VALUE per line, no shell expansion, no inline comments.
# Everything after the first "=" is the value, so a password may contain #, $ or
# spaces. Quote a value only to strip surrounding whitespace.
# A variable already exported in your shell always wins over this file.


# ---------------------------------------------------------------------------
# Key rotation, for any variable below
# ---------------------------------------------------------------------------
# The plain variable name is slot 1. Add a slot 2 by suffixing the variable
# name with _2, slot 3 with _3, and so on up to 20. A quota bearing service
# switches to the next slot automatically once the current one is rejected
# (HTTP 401, 402, 403, 429) or reports an equivalent failure, and is not
# retried for 30 minutes (override with AI_CONTENT_KEY_COOLDOWN, seconds).
#
#     PEXELS_API_KEY=REPLACE_ME_SLOT_1
#     PEXELS_API_KEY_2=REPLACE_ME_SLOT_2
#
# A single slot, the common case, needs no change: the unsuffixed name has
# always meant slot 1.


# ---------------------------------------------------------------------------
# Hero images. AT LEAST ONE IS REQUIRED for a Vietnamese post.
# ---------------------------------------------------------------------------
# Openverse is the only keyless source and it indexes English metadata only, so
# a Vietnamese query returns nothing and Gate 2 fails on a missing hero image.
# All three stock providers below have a free tier.

# https://www.pexels.com/api/          200 requests/hour
PEXELS_API_KEY=

# https://unsplash.com/developers      50 requests/hour
UNSPLASH_ACCESS_KEY=

# https://pixabay.com/api/docs/        100 requests/minute
PIXABAY_API_KEY=

# https://aistudio.google.com/apikey   Gemini image generation, billed per image
GOOGLE_AI_API_KEY=
# NANOBANANA_MODEL=gemini-3.1-flash-image


# ---------------------------------------------------------------------------
# DataForSEO. Optional. Needed only for keyword and competitor research.
# ---------------------------------------------------------------------------
# Billed per task, not per keyword, so batch up to 1000 keywords per call.
# Verify the account without spending anything:
#     python3 ../claude-seo/scripts/dfs_vn_probe.py
# Both variable names are accepted; the two repos historically disagreed.
DATAFORSEO_USERNAME=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=


# ---------------------------------------------------------------------------
# claude-seo extras. All optional.
# ---------------------------------------------------------------------------
# https://moz.com/products/api                  backlink metrics
MOZ_API_KEY=
# https://www.bing.com/webmasters               Bing Webmaster Tools
BING_WEBMASTER_API_KEY=
# Any self chosen 8 to 128 char hex string, published at INDEXNOW_KEY_LOCATION
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
# Google Search Console, PageSpeed Insights, CrUX, GA4
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=
GSC_PROPERTY=


# ---------------------------------------------------------------------------
# Publishing. Optional, only for `blog sync` to a git repository.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
